{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sanchuanhehe/modelzoo/ci/hil/schemas/lab-inventory.schema.json",
  "title": "ModelZoo HIL laboratory inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "$defs": {
    "source": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "repository", "credentialRef", "accessClass", "authorizationStatus"],
          "properties": {
            "kind": {"const": "github-release"},
            "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "credentialRef": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
            "accessClass": {"enum": ["public", "restricted"]},
            "authorizationStatus": {"const": "approved"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "authorizationStatus"],
          "properties": {
            "kind": {"const": "unresolved"},
            "authorizationStatus": {"const": "pending"}
          }
        }
      ]
    }
  },
  "properties": {
    "apiVersion": {"const": "modelzoo.hil/v1alpha1"},
    "kind": {"const": "LabInventory"},
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"}}
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["runner", "targets", "assetSources"],
      "properties": {
        "runner": {
          "type": "object", "additionalProperties": false,
          "required": ["labels", "environment", "runRoot"],
          "properties": {
            "labels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"}},
            "environment": {"const": "hil-hi3403"},
            "runRoot": {"const": "/opt/hil/runs"}
          }
        },
        "targets": {
          "type": "object", "minProperties": 1, "maxProperties": 32,
          "propertyNames": {"pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"},
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["targetClass", "host", "user", "executionMode", "serialDevice", "sshCredentialRef", "knownHostsCredentialRef", "concurrencyGroup"],
            "properties": {
              "targetClass": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"},
              "host": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$"},
              "user": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$"},
              "executionMode": {"enum": ["unprivileged", "forced-command-root"]},
              "executionRationale": {"type": "string", "minLength": 16, "maxLength": 512},
              "serialDevice": {"type": "string", "pattern": "^/dev/serial/by-id/[A-Za-z0-9._-]+$"},
              "sshCredentialRef": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
              "knownHostsCredentialRef": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
              "concurrencyGroup": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"}
            },
            "allOf": [
              {
                "if": {"properties": {"executionMode": {"const": "forced-command-root"}}},
                "then": {"required": ["executionRationale"], "properties": {"user": {"const": "root"}}},
                "else": {"properties": {"user": {"not": {"const": "root"}}}}
              }
            ]
          }
        },
        "assetSources": {
          "type": "object", "minProperties": 1, "maxProperties": 32,
          "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
          "additionalProperties": {"$ref": "#/$defs/source"}
        }
      }
    }
  }
}
