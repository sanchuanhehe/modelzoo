{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sanchuanhehe/modelzoo/ci/hil/schemas/lab-control-event.schema.json",
  "title": "ModelZoo HIL lab-control event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "labControlVersion", "command", "status", "timestamp", "details"],
  "properties": {
    "schemaVersion": {"const": 1},
    "labControlVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "command": {"type": "string", "pattern": "^[a-z]+(?:[.-][a-z]+)*$"},
    "status": {"enum": ["passed", "failed"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "details": {"type": "object"}
  }
}
